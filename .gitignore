# Python cache and environments
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/

# R history/session files
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata

# Jupyter
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Raw and processed data directories
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# Output artifacts
/output/*
!/output/figures/
!/output/figures/.gitkeep
!/output/tables/
!/output/tables/.gitkeep

# Common large data files
*.csv
*.parquet
*.rds
*.dta
*.xlsx

# Allow tracked project metadata files and scaffold markers
!/data/README.md
!/data/series_dictionary.csv
!**/.gitkeep
